# Absolute path to a mode-0600 file containing a strong Grafana operator password.
GRAFANA_ADMIN_PASSWORD_FILE=/etc/family-jobs-board-observability/grafana-admin-password

# Stable cross-project network used only for application-to-Alloy OTLP traffic.
# Create it with scripts/ensure-observability-network.sh before starting either
# Compose project. Both projects treat it as external, so `down` cannot remove it.
TELEMETRY_NETWORK_NAME=family-jobs-board-telemetry

# Private external bridge used only by Caddy and Grafana. Create or validate it
# with scripts/ensure-monitor-network.sh before applying either ingress overlay.
MONITOR_INGRESS_NETWORK_NAME=family-jobs-board-monitor-ingress

# LAN address and hostname used by Blackbox to exercise the application through
# Caddy. The explicit hosts entry avoids relying on Docker's embedded resolver
# to forward the private home.arpa zone.
APP_PROBE_HOSTNAME=dashboard.home.arpa
APP_PROBE_ADDRESS=192.168.0.100

# Numeric group owner of Docker's Unix socket on Serendipity. Resolve it with:
# stat -c '%g' /var/run/docker.sock
# Only the privacy-bounded container exporter uses this group.
DOCKER_GID=998

# Compose project label used to select the four Family Jobs Board runtime
# services. The collector also enforces its own fixed api/db/proxy/web allowlist.
FJB_COMPOSE_PROJECT_NAME=family-jobs-board

# Required only with compose.storage-bounds.yaml. Each directory must already
# exist and be the root of its own local, POSIX filesystem with the stated cap.
PROMETHEUS_DATA_DIR=/srv/family-jobs-board-observability/prometheus
LOKI_DATA_DIR=/srv/family-jobs-board-observability/loki
