          "instant": true,
          "legendFormat": "{{service}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Private service endpoint health",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "environment": true,
              "job": true
            },
            "indexByName": {
              "service": 0,
              "Value": 1
            },
            "renameByName": {
              "Value": "Health",
              "service": "Service"
            }
          }
        }
      ],
      "type": "table"
    },
