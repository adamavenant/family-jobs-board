              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/StartMemberResponse"
            }
          },
          "members": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/StartMemberResponse"
            }
          }
        }
