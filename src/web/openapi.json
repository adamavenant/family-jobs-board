            "type": "string"
          },
          "memberId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "firstName": {
            "type": [
              "null",
              "string"
            ]
          },
          "surname": {
            "type": [
              "null",
              "string"
            ]
          },
          "pin": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
